local H = MH.H

H.Copy = function(text)
    if setclipboard then
        setclipboard(text)
        return true
    elseif toclipboard then
        toclipboard(text)
        return true
    end

    return false
end

H.GetPing = function()
    local ok, ping = pcall(function()
        return S.Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)

    if ok and ping then
        return math.floor(ping)
    end

    return 0
end

H.GetAccountAge = function()
    return S.LP.AccountAge .. " days"
end

H.GetExecutor = function()
    if identifyexecutor then
        return identifyexecutor()
    end

    return "Unknown"
end

task.spawn(function()
    local frames = 0
    local last = tick()

    S.Run.RenderStepped:Connect(function()
        frames += 1

        if tick() - last >= 1 then
            V.FPS = frames
            V.Ping = H.GetPing()

            frames = 0
            last = tick()
        end
    end)
end)

